<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Tell Us About Yourself"
        android:textColor="@color/textColor"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvOnboardingSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Help us personalize your fitness experience for better results."
        android:textAlignment="center"
        android:textColor="@color/textSecondary"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOnboardingTitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAge"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/borderStroke"
        app:boxStrokeWidth="1dp"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_calender"
        app:startIconTint="@color/input_icon_tint"
        app:layout_constraintTop_toBottomOf="@id/tvOnboardingSubtitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Age (Years)"
            android:textColorHint="@color/input_hint_color"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingVertical="16dp"
            android:textColor="@color/textColor"
            android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilHeight"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/borderStroke"
        app:boxStrokeWidth="1dp"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_height"
        app:startIconTint="@color/input_icon_tint"
        app:layout_constraintTop_toBottomOf="@id/tilAge">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Height (cm)"
            android:textColorHint="@color/input_hint_color"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingVertical="16dp"
            android:textColor="@color/textColor"
            android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilWeight"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/borderStroke"
        app:boxStrokeWidth="1dp"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_weight"
        app:startIconTint="@color/input_icon_tint"
        app:layout_constraintTop_toBottomOf="@id/tilHeight">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Weight (kg)"
            android:textColorHint="@color/input_hint_color"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingVertical="16dp"
            android:textColor="@color/textColor"
            android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFitnessGoal"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/borderStroke"
        app:boxStrokeWidth="1dp"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_goal"
        app:startIconTint="@color/input_icon_tint"
        app:endIconTint="@color/input_icon_tint"
        app:layout_constraintTop_toBottomOf="@id/tilWeight">

        <AutoCompleteTextView
            android:id="@+id/actvFitnessGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Fitness Goal"
            android:textColorHint="@color/input_hint_color"
            android:inputType="none"
            android:paddingStart="12dp"
            android:paddingVertical="16dp"
            android:textColor="@color/textColor"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCompleteProfile"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="Complete Setup"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/gradient_auth_center"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>